{
    // Show the output panel automatically when an error occurs
    "show_panel_on_error": true,

    // Auto-hide the output panel N seconds after all operations finish (0 = keep open always)
    "auto_hide_panel": 4,

    // Log successful uploads/downloads to the output panel
    "log_operations": true,

    // Folder containing the OpenSSH binaries (ssh, sftp, scp, ssh-keygen).
    // Empty = auto-detect (System32\OpenSSH on Windows, then PATH).
    // Useful when the system OpenSSH is too old, e.g. "E:/tools/OpenSSH-Win64"
    "ssh_bin_dir": ""
}
